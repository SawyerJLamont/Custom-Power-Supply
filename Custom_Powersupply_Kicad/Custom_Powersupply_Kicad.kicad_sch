	(text "Antena\n"
		(exclude_from_sim no)
		(at 109.982 149.606 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0c3fb792-4966-458e-9ad7-0e7f2b9bc65e")
	)
	(text "USB Input\nUsing Rset to ask for 15 V input from input as shown in data sheet\n"
		(exclude_from_sim no)
		(at 53.848 67.564 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "24bc52f4-ba2a-4ded-a79e-093a5a942636")
	)
	(text "Rotary Encoder:\nIncludes caps for bounce and possible interference from \nconverter inductors\nAcounts for pull up resitors already on breakout board\nMake sure to check if final product board as resitors included\n"
		(exclude_from_sim no)
		(at 42.926 165.354 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2850e61f-3f62-4ff3-8b44-f9ea32de2748")
	)
	(text "This would require a value of 55.6 uH,\n but the IC has an ECO mode that enables\n at light loads, meaning a inductor value \nof 22 uH inductor will be ok"
		(exclude_from_sim no)
		(at 104.648 130.302 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2df1dcd4-1a4f-479d-84fb-faa018c032d3")
	)
	(text "Physical switch that can be \nused to cut all power to system.\n+15V_In will be the controlled source\nfor both buck converters\n\n"
		(exclude_from_sim no)
		(at 109.22 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4b7b245f-bd84-49be-8a9e-e10519757bfb")
	)
	(text "Using logic where system will default to 3.3 volts even if ESP32 is off.\nTo calculate the parallel resitance required to reach other voltages,\nI used the equation below. Where V_ref = 0.596V and R2 is 100k.\n(Refrence R4). This gives a target resistance. Then solving for the\n required parallel resitance. This give 34.8K for 5V and 10.5k for 9 V."
		(exclude_from_sim no)
		(at 192.532 21.082 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ff7cf07-bcdc-4cb3-a4f2-54be20396329")
	)
	(text "Voltage regualtor for ESP32\nDesign Choice:\nGot rid of EN voltage divider so ESP32 will turn on directly on boot instead of waiting for 15V.\nGot rid of small resistor in fron of FB biasing divider as it is not needed for this application\nUsed a smaller inductor as ESP32 will only pull at most 0.5-0.6 A, calculated using equation:\n"
		(exclude_from_sim no)
		(at 72.898 118.364 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f670a2e9-fea9-473a-8b49-c31e6dc17cfb")
	)
	(text "USB"
		(exclude_from_sim no)
		(at 110.236 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f94e4eab-afdc-4950-b8b2-236bf768c8e0")
	)
